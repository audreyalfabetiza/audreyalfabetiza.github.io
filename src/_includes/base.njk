<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
{%- set pageTitle = title if title else site.nome + " | " + site.profissao + " em " + site.cidade %}
{%- set pageDesc = description if description else site.descricao %}
{%- set canonical = meta.url + page.url %}
{%- set ogImage = (meta.url + ogimage) if ogimage else (meta.url + "/assets/img/og.jpg") %}
<title>{{ pageTitle }}</title>
<meta name="description" content="{{ pageDesc }}">
<link rel="canonical" href="{{ canonical }}">
{%- if noindex %}<meta name="robots" content="noindex, nofollow">{% else %}<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1">{% endif %}
<meta name="theme-color" content="#3F7FD0">
<meta name="author" content="{{ site.nome }}">
<meta name="geo.region" content="BR-PR">
<meta name="geo.placename" content="{{ site.cidade }}">
<meta name="geo.position" content="{{ site.latitude }};{{ site.longitude }}">
<meta property="og:locale" content="pt_BR">
<meta property="og:site_name" content="{{ site.nome }}">
<meta property="og:type" content="{{ 'article' if ogtype == 'article' else 'website' }}">
<meta property="og:title" content="{{ pageTitle }}">
<meta property="og:description" content="{{ pageDesc }}">
<meta property="og:url" content="{{ canonical }}">
<meta property="og:image" content="{{ ogImage }}">
<meta property="og:image:alt" content="{{ ogalt if ogalt else site.nome + ', ' + site.profissao + ' em ' + site.cidade }}">
{%- if ogtype == 'article' %}
<meta property="article:published_time" content="{{ date | iso }}">
<meta property="article:author" content="{{ site.nome }}">
{%- endif %}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ pageTitle }}">
<meta name="twitter:description" content="{{ pageDesc }}">
<meta name="twitter:image" content="{{ ogImage }}">
<link rel="icon" href="/assets/img/favicon-32.png" sizes="32x32">
<link rel="apple-touch-icon" href="/assets/img/apple-touch-icon.png">
<link rel="alternate" type="application/rss+xml" title="{{ site.nome }} | Conteúdos" href="/feed.xml">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Manrope:wght@600;700;800&family=Nunito+Sans:wght@400;600;700&display=swap" onload="this.rel='stylesheet'">
<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@600;700;800&family=Nunito+Sans:wght@400;600;700&display=swap" rel="stylesheet" media="print" onload="this.media='all'">
<noscript><link href="https://fonts.googleapis.com/css2?family=Manrope:wght@600;700;800&family=Nunito+Sans:wght@400;600;700&display=swap" rel="stylesheet"></noscript>
<link rel="stylesheet" href="/assets/css/style.css">
{% include "schema.njk" %}
</head>
<body>
<a class="skip" href="#conteudo">Ir para o conteúdo</a>
<header class="top">
  <div class="wrap">
    <div class="bar">
      <a class="brand" href="/" aria-label="{{ site.nome }}, {{ site.profissao | lower }}">
        <img src="/assets/img/mark.png" alt="" width="38" height="37">
        <div><b>{{ site.nome }}</b><span>{{ site.profissao | lower }}</span></div>
      </a>
      <a class="btn btn-primary btn-sm" href="{{ meta.wa.conversa }}" target="_blank" rel="noopener">Agendar conversa</a>
    </div>
    <nav class="tabs" aria-label="Seções do site">
      {%- for item in nav %}
      <a class="tab" href="{{ item.url }}"{% if page.url == item.url or (page.url and item.url != '/' and page.url.startsWith(item.url)) %} aria-current="page"{% endif %}>{{ item.texto }}</a>
      {%- endfor %}
    </nav>
  </div>
</header>

<main id="conteudo">
{{ content | safe }}
</main>

<a class="wa-float" href="{{ meta.wa.conversa }}" target="_blank" rel="noopener" aria-label="Falar com a Audrey no WhatsApp"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5.1-1.3A10 10 0 1 0 12 2zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.2-.4.2-.4.7-1.3.1-.2 0-.3 0-.5l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2c0 1.3.9 2.5 1 2.7.1.2 1.8 2.8 4.4 3.9 1.6.7 2.3.7 3.1.6.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2-.1-.1-.3-.2-.5-.3z"/></svg></a>

<footer>
  <div class="wrap foot">
    <div>
      <b>{{ site.nome }}</b>, {{ site.profissao | lower }}<br>
      {{ site.rua }}, {{ site.bairro }}, {{ site.cidade }}, {{ site.estado }}<br>
      <a href="https://wa.me/{{ site.whatsapp }}" target="_blank" rel="noopener">WhatsApp {{ site.telefone }}</a>
    </div>
    <div class="foot-links">
      <a href="/conteudos/">Conteúdos</a>
      <a href="/perguntas-frequentes/">Perguntas frequentes</a>
      <a href="/politica-de-privacidade/">Política de privacidade</a>
      {%- if site.instagram %}<a href="{{ site.instagram }}" target="_blank" rel="noopener me">Instagram</a>{% endif %}
    </div>
    <div class="foot-copy">© {{ meta.ano }} {{ site.nome }} · Ciência Cognitiva da Leitura · {{ site.cidade }}, {{ site.estado }}</div>
  </div>
</footer>
</body>
</html>
