{%- set orgId = meta.url + "/#negocio" -%}
{%- set pessoaId = meta.url + "/#audrey" -%}
{%- set sameAs = [] -%}
{%- if site.instagram %}{% set sameAs = (sameAs.push(site.instagram), sameAs) %}{% endif -%}
{%- if site.google_avaliacoes %}{% set sameAs = (sameAs.push(site.google_avaliacoes), sameAs) %}{% endif -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["LocalBusiness", "EducationalOrganization"],
      "@id": "{{ orgId }}",
      "name": "{{ site.nome }} | {{ site.profissao }}",
      "description": {{ site.descricao | json | safe }},
      "url": "{{ meta.url }}/",
      "image": "{{ meta.url }}/assets/img/og.jpg",
      "logo": "{{ meta.url }}/assets/img/icon-512.png",
      "telephone": "+{{ site.whatsapp }}",
      "priceRange": "$$",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "{{ site.rua }}",
        "addressLocality": "{{ site.cidade }}",
        "addressRegion": "{{ site.estado }}",
        "postalCode": "{{ site.cep }}",
        "addressCountry": "BR"
      },
      "geo": { "@type": "GeoCoordinates", "latitude": {{ site.latitude }}, "longitude": {{ site.longitude }} },
      "hasMap": "{{ site.mapa }}",
      "areaServed": [ { "@type": "City", "name": "{{ site.cidade }}" }{% for b in site.bairros_proximos %}, { "@type": "Place", "name": {{ b | json | safe }} }{% endfor %} ],
      "founder": { "@id": "{{ pessoaId }}" },
      "knowsAbout": ["alfabetização", "pré-alfabetização", "Ciência Cognitiva da Leitura", "consciência fonêmica", "método fônico", "leitura e escrita", "ortografia", "fluência de leitura", "compreensão leitora"]
      {%- if sameAs.length %},
      "sameAs": {{ sameAs | json | safe }}
      {%- endif %}
    },
    {
      "@type": "Person",
      "@id": "{{ pessoaId }}",
      "name": "{{ site.nome }}",
      "jobTitle": "Pedagoga alfabetizadora",
      "description": "Pedagoga alfabetizadora, especialista em Alfabetização e Letramento e em Ciência Cognitiva da Leitura, com mais de 15 anos de experiência na educação.",
      "url": "{{ meta.url }}/sobre/",
      "image": "{{ meta.url }}/assets/img/audrey.jpg",
      "worksFor": { "@id": "{{ orgId }}" },
      "knowsAbout": ["alfabetização", "Ciência Cognitiva da Leitura"]
    },
    {
      "@type": "WebSite",
      "@id": "{{ meta.url }}/#site",
      "url": "{{ meta.url }}/",
      "name": "{{ site.nome }}",
      "inLanguage": "pt-BR",
      "publisher": { "@id": "{{ orgId }}" }
    },
    {
      "@type": "WebPage",
      "@id": "{{ meta.url }}{{ page.url }}#pagina",
      "url": "{{ meta.url }}{{ page.url }}",
      "name": {{ (title if title else site.nome) | json | safe }},
      "description": {{ (description if description else site.descricao) | json | safe }},
      "inLanguage": "pt-BR",
      "isPartOf": { "@id": "{{ meta.url }}/#site" },
      "about": { "@id": "{{ orgId }}" }
    }
    {%- if crumbs %},
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Início", "item": "{{ meta.url }}/" }
        {%- for c in crumbs %},
        { "@type": "ListItem", "position": {{ loop.index + 1 }}, "name": {{ c.nome | json | safe }}, "item": "{{ meta.url }}{{ c.url }}" }
        {%- endfor %}
      ]
    }
    {%- endif %}
    {%- if schemaTipo == "faq" %},
    {
      "@type": "FAQPage",
      "mainEntity": [
        {%- for f in faq.itens %}
        { "@type": "Question", "name": {{ f.pergunta | json | safe }}, "acceptedAnswer": { "@type": "Answer", "text": {{ f.resposta | json | safe }} } }{% if not loop.last %},{% endif %}
        {%- endfor %}
      ]
    }
    {%- endif %}
    {%- if schemaTipo == "servicos" %},
    { "@type": "Service", "name": "Pré-alfabetização", "serviceType": "Pré-alfabetização", "description": "Para crianças que ainda estão construindo as habilidades que dão suporte à aprendizagem da leitura e da escrita: consciência fonológica e fonêmica, conhecimento das letras e dos sons, linguagem oral e vocabulário.", "provider": { "@id": "{{ orgId }}" }, "areaServed": { "@type": "City", "name": "{{ site.cidade }}" }, "audience": { "@type": "PeopleAudience", "suggestedMinAge": 4, "suggestedMaxAge": 11 } },
    { "@type": "Service", "name": "Alfabetização", "serviceType": "Alfabetização", "description": "Para crianças que estão aprendendo a ler e escrever: decodificação, codificação, leitura com precisão e fluência e produção escrita.", "provider": { "@id": "{{ orgId }}" }, "areaServed": { "@type": "City", "name": "{{ site.cidade }}" }, "audience": { "@type": "PeopleAudience", "suggestedMinAge": 4, "suggestedMaxAge": 11 } },
    { "@type": "Service", "name": "Aprimoramento da leitura e da escrita", "serviceType": "Aperfeiçoamento da leitura e da escrita", "description": "Para crianças que já leem e escrevem, mas têm lacunas de fluência, ortografia, morfologia, vocabulário e compreensão.", "provider": { "@id": "{{ orgId }}" }, "areaServed": { "@type": "City", "name": "{{ site.cidade }}" }, "audience": { "@type": "PeopleAudience", "suggestedMinAge": 4, "suggestedMaxAge": 11 } }
    {%- endif %}
    {%- if schemaTipo == "post" %},
    {
      "@type": "BlogPosting",
      "headline": {{ title | json | safe }},
      "description": {{ description | json | safe }},
      "datePublished": "{{ date | iso }}",
      "dateModified": "{{ (atualizado if atualizado else date) | iso }}",
      "inLanguage": "pt-BR",
      "mainEntityOfPage": "{{ meta.url }}{{ page.url }}",
      "image": "{{ ogImage }}",
      "author": { "@id": "{{ pessoaId }}" },
      "publisher": { "@id": "{{ orgId }}" }
      {%- if tags_post and tags_post.length %},
      "keywords": {{ tags_post | json | safe }}
      {%- endif %}
    }
    {%- endif %}
    {%- if schemaTipo == "post" and perguntas and perguntas.length %},
    {
      "@type": "FAQPage",
      "mainEntity": [
        {%- for f in perguntas %}
        { "@type": "Question", "name": {{ f.pergunta | json | safe }}, "acceptedAnswer": { "@type": "Answer", "text": {{ f.resposta | json | safe }} } }{% if not loop.last %},{% endif %}
        {%- endfor %}
      ]
    }
    {%- endif %}
  ]
}
</script>
