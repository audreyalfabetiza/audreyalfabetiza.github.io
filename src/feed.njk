---
permalink: /feed.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0"><channel>
<title>{{ site.nome }} | Conteúdos</title><link>{{ meta.url }}/conteudos/</link><description>{{ site.descricao }}</description><language>pt-BR</language>
{%- for p in collections.posts | limit(20) %}
<item><title>{{ p.data.title | escape }}</title><link>{{ meta.url }}{{ p.url }}</link><guid>{{ meta.url }}{{ p.url }}</guid><pubDate>{{ p.date.toUTCString() }}</pubDate><description>{{ p.data.description | escape }}</description></item>
{%- endfor %}
</channel></rss>
